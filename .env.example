# =============================================================================
# PersonalAI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# All LLM providers and tool APIs use FREE tiers.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Providers (All Free — Sign up at the links below)
# -----------------------------------------------------------------------------

# PRIMARY: Groq (Ultrafast LLaMA 3.3 70B / 30 RPM free)
# Sign up: https://console.groq.com
GROQ_API_KEY=

# SECONDARY: Cerebras (1M tokens/day free)
# Sign up: https://inference.cerebras.ai
CEREBRAS_API_KEY=

# TERTIARY: Google Gemini (15 RPM free)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# FALLBACK 1: GitHub Models (GPT-4o-mini, 150 RPD free)
# Use your GitHub Personal Access Token
# Create: https://github.com/settings/tokens
GITHUB_TOKEN=

# FALLBACK 2: OpenRouter (20+ free models)
# Sign up: https://openrouter.ai
OPENROUTER_API_KEY=

# OFFLINE: Ollama (local, no key needed)
# Install: https://ollama.com
# Pull model: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Database — Supabase
# -----------------------------------------------------------------------------
# Create project: https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personalai

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Temporal
# -----------------------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# -----------------------------------------------------------------------------
# Observability — Langfuse (Free OSS)
# -----------------------------------------------------------------------------
# Self-host or use cloud: https://langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# Tool API Keys (All Free Tiers)
# -----------------------------------------------------------------------------

# Yelp Fusion (500 req/day free)
# Sign up: https://fusion.yelp.com
YELP_API_KEY=

# Amadeus (2000 req/month test tier)
# Sign up: https://developers.amadeus.com
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Tavily Search (1000 req/month free)
# Sign up: https://tavily.com
TAVILY_API_KEY=

# Mapbox (100K geocodes/month free)
# Sign up: https://mapbox.com
MAPBOX_ACCESS_TOKEN=

# Google OAuth (for Calendar, Gmail, Contacts)
# Setup: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret-key
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Agent Settings
AGENT_MAX_STEPS=20
AGENT_MAX_TOKENS_PER_EXECUTION=100000
